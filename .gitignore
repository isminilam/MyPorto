# ==========================================
# Dependencies
# ==========================================
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# Next.js & Build Outputs
# ==========================================
.next/
out/
build/
dist/
.turbo/

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
# Ignore all .env files containing sensitive keys/tokens
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow committing sample/template env file if created
!.env.example

# Secret keys, credentials & SSL certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
*secret*.json
id_rsa*

# ==========================================
# Debug & Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/

# ==========================================
# IDE & Code Editors
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.cursor/

# ==========================================
# Operating System Artifacts
# ==========================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ==========================================
# Vercel & Cloud Deployments
# ==========================================
.vercel/
.serverless/

# ==========================================
# TypeScript & Build Caches
# ==========================================
*.tsbuildinfo
next-env.d.ts

# ==========================================
# Temporary & Scratch Files
# ==========================================
*.tmp
*.temp
.tmp/
.temp/
*.bak
*.backup
*.old
